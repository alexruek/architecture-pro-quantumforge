@startuml task6_update_flow
title Алгоритм одного запуска update_index.py

skinparam shadowing false
skinparam defaultFontSize 13

start
:Запуск (cron или вручную);
if (Блокировка свободна?) then (нет)
  :Лог: обновление уже выполняется;
  stop
endif
:Сканирование источника,\nsha256 каждого файла;
:Чтение манифеста и проверка индекса;
if (Нужна полная пересборка?\nнет манифеста, сменились модель или\nпараметры чанков, индекс поврежден,\nчисло векторов не сходится, флаг --full) then (да)
  :План: все файлы считаются новыми;
else (нет)
  :План: сравнение хешей с манифестом\nновые, измененные, удаленные;
endif
if (В источнике есть документы?) then (нет)
  :Ошибка: источник пуст или не смонтирован,\nиндекс не изменен;
  :Запись в лог, код выхода 1;
  stop
endif
if (Режим --dry-run?) then (да)
  :Показать план, ничего не менять;
  stop
endif
if (Есть изменения?) then (нет)
  :Лог: изменений нет;
  :Код выхода 0;
  stop
endif
:Чтение новых и измененных файлов\nпроверка правилами injection_guard\n(предупреждение или карантин);
:Разбиение на чанки;
:Эмбеддинги чанков;
:Удаление чанков измененных и\nудаленных файлов из FAISS;
:Добавление новых чанков;
:Атомное сохранение:\nсначала index.pkl, затем index.faiss;
:Запись manifest.json;
:Запись итога в update_index.log\nи update_runs.jsonl;
if (Были ошибки по файлам?) then (да)
  :Код выхода 1\nrun_update.sh повторит запуск;
else (нет)
  :Код выхода 0;
endif
stop
@enduml
