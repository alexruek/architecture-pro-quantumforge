# Ключ OpenAI. Без ключа бот использует локальную модель LOCAL_LLM_MODEL_NAME
OPENAI_API_KEY=

# Остальные переменные необязательны: значения по умолчанию заданы в src/config.py.
# Раскомментируйте строку, чтобы переопределить значение

# OPENAI_MODEL_NAME=gpt-4o-mini
# LOCAL_LLM_MODEL_NAME=google/flan-t5-base
# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# KNOWLEDGE_BASE_DIR=knowledge_base
# INDEX_PATH=faiss_index
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=100
# TOP_K=4
# RELEVANCE_THRESHOLD=0.76
# PROTECTION_LEVEL=3

# Задание 6: карантин документов с признаками промпт-инъекции при обновлении индекса
# QUARANTINE_INJECTIONS=false

# Задание 7: проверка качества после ежедневного обновления индекса
# RUN_EVAL_AFTER_UPDATE=false
# EVAL_MIN_PASS=0.7
